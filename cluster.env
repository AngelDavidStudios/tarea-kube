# Valores del clúster Talos local (QEMU en la Mac). Edita y corre: bash cluster/create.sh
CLUSTER_NAME=talos-lab            # también nombra ~/.talos/<nombre> y ~/.kube/<nombre>
TALOS_VERSION=v1.14.5
KUBERNETES_VERSION=1.37.1         # Talos 1.14 admite de 1.33 a 1.37
CIDR=10.5.0.0/24                  # red de las VMs (/24); otra distinta si levantas dos clústeres a la vez
CONTROLPLANES=1                   # 1 o 3 (etcd necesita mayoría)
WORKERS=1                         # al menos 1: ahí corren los pods y el volumen de local-path
CONTROLPLANE_CPUS=2
CONTROLPLANE_MEMORY=2GiB
WORKER_CPUS=2
WORKER_MEMORY=3GiB
SYSTEM_DISK=10GiB                 # disco del sistema de cada nodo
WORKER_DATA_DISK=6GiB             # segundo disco de cada worker: volumen de local-path (patches/worker.yaml)
LOCAL_PATH_VERSION=v0.0.37
